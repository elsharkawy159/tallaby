# Database (shared Postgres — see @workspace/db)
DATABASE_URL=postgresql://REPLACE_ME

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
NEXT_PUBLIC_SUPABASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# Admin-only auth cookie (keeps admin session separate from marketplace apps)
# NEXT_PUBLIC_SUPABASE_ADMIN_AUTH_COOKIE_NAME=sb-<project-ref>-admin-auth-token

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cross-app cache invalidation (packages/cache — see docs/caching-and-data-fetching.md §7).
# Without these, approving/editing a product here still writes to the DB, but
# the storefront won't reflect it until its own cache TTL expires (up to 15
# min for listings) instead of showing up immediately.
# REVALIDATE_SECRET must be the exact same value in the ecommerce and
# dashboard apps' env too.
ECOMMERCE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
REVALIDATE_SECRET=REPLACE_WITH_SHARED_SECRET

# PostHog
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=REPLACE_WITH_PROJECT_ID
POSTHOG_PERSONAL_API_KEY=REPLACE_WITH_PERSONAL_API_KEY
