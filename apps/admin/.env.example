# Database (shared Postgres — see @workspace/db)
DATABASE_URL=postgresql://REPLACE_ME

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
NEXT_PUBLIC_SUPABASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
# Admin-only auth cookie (keeps admin session separate from marketplace apps)
# NEXT_PUBLIC_SUPABASE_ADMIN_AUTH_COOKIE_NAME=sb-<project-ref>-admin-auth-token

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cross-app cache invalidation (packages/cache — see docs/caching-and-data-fetching.md §7).
# Without these, approving/editing a product here still writes to the DB, but
# the storefront won't reflect it until its own cache TTL expires (up to 15
# min for listings) instead of showing up immediately.
# REVALIDATE_SECRET must be the exact same value in the ecommerce and
# dashboard apps' env too.
ECOMMERCE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
ECOMMERCE_REVALIDATE_URL=
MARKETING_URL=
REVALIDATE_SECRET=REPLACE_WITH_SHARED_SECRET

# Custom domains (Domains page: re-check / remove). Same values as the dashboard:
# the ecommerce Vercel project that serves seller domains. Server-only.
STOREFRONT_VERCEL_PROJECT_ID=
STOREFRONT_VERCEL_TOKEN=
STOREFRONT_VERCEL_TEAM_ID=

# Custom domain provider switch (docs/plans/hetzner-migration.md §7.3 #3).
# CUSTOM_DOMAIN_PROVIDER picks the provider for NEW domains (vercel | cloudflare,
# default vercel); existing rows always use their own provider column.
# Cloudflare for SaaS: an API token with zone "SSL and Certificates: Edit" on
# tallaby.com (server-only, never logged) and the zone id. CUSTOM_DOMAIN_CNAME_TARGET
# is the host sellers CNAME to (default shops.tallaby.com).
CUSTOM_DOMAIN_PROVIDER=
CLOUDFLARE_SAAS_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_CNAME_TARGET=

# AI for Admin > Store > Products > Fill with AI (server-only, never NEXT_PUBLIC_). Same paid Gemini key as the dashboard.
GOOGLE_GENERATIVE_AI_API_KEY=
# Admin AI product autofills per admin per Cairo day (default 200)
# AI_ADMIN_PRODUCT_AUTOFILL_DAILY_LIMIT=200
