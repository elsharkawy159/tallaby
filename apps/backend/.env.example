# =============================================================================
# DEV — local defaults (copy to .env and fill secrets)
# =============================================================================
PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://REPLACE_ME

RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=info@tallaby.com
EMAIL_FROM_NAME=Tallaby
EMAIL_FROM_ORDERS=orders@tallaby.com
RESEND_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
INTERNAL_API_SECRET=REPLACE_WITH_SHARED_SECRET
ORDER_ACCESS_SECRET=replace-with-a-long-random-string

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
ECOMMERCE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID

PAYMOB_SECRET_KEY=egy_sk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_PUBLIC_KEY=egy_pk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_API_KEY=REPLACE_WITH_YOUR_API_KEY
PAYMOB_HMAC_SECRET=REPLACE_WITH_YOUR_HMAC_SECRET
PAYMOB_CARD_INTEGRATION_ID=4604192
PAYMOB_MOTO_INTEGRATION_ID=REPLACE_WITH_MOTO_INTEGRATION_ID
PAYMOB_WEBHOOK_URL=https://hooks.paymob.com/REPLACE_WITH_YOUR_HOOK_ID

