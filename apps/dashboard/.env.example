# Database (shared Postgres — see @workspace/db)
DATABASE_URL=postgresql://REPLACE_ME

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
# Server only. Signs the editor/media-library uploads (store-media) and top-up proofs;
# without it every image upload in the website builder fails.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Cross-app cache invalidation (packages/cache — see docs/caching-and-data-fetching.md §7).
# Without these, a seller-side product mutation still writes to the DB, but
# the storefront won't reflect it until its own cache TTL expires (up to 15
# min for listings) instead of showing up immediately.
# REVALIDATE_SECRET must be the exact same value in the ecommerce and admin
# apps' env too.
ECOMMERCE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=REPLACE_WITH_SHARED_SECRET

# Seller custom domains (faster-eg.com). A Vercel token that can manage the
# ECOMMERCE project's domains; STOREFRONT_VERCEL_PROJECT_ID is that project in both apps.
STOREFRONT_VERCEL_PROJECT_ID=
STOREFRONT_VERCEL_TOKEN=
STOREFRONT_VERCEL_TEAM_ID=

# Signs the httpOnly cookie that carries signup choices across Google OAuth
# (PLAN.md §6.5). Server-only, at least 32 characters: openssl rand -hex 32
SIGNUP_INTENT_SECRET=

# Encrypts store integration secrets at rest (PLAN.md §9.1, P7-01). Server-only,
# 32 bytes as hex or base64: openssl rand -hex 32. Needed once token-based apps
# (Meta CAPI, Shopify import, Google Sheets) ship; never NEXT_PUBLIC_.
INTEGRATIONS_ENCRYPTION_KEY=

# Store-wallet top-ups through Kashier (PLAN.md P6-09). Server-only, same values
# as the ecommerce app. KASHIER_WEBHOOK_URL is the backend /api/kashier/webhook.
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
KASHIER_MERCHANT_ID=
KASHIER_WEBHOOK_URL=
KASHIER_MODE=test

# Store builder rollout (PLAN.md P3-01). Unset = every seller gets Website & Content.
# Set "all", a comma list of seller ids to limit it, or empty to switch it off.
# STORE_BUILDER_SELLER_IDS=

# Stock photos for the website editor Explore tab (server-only; never NEXT_PUBLIC_)
PEXELS_API_KEY=

# Store views (PLAN.md SA-01, docs/store-views.md; server-only, never NEXT_PUBLIC_).
# Tallaby's GA4 property (numeric id) and a service account with Viewer on it.
# Unset: Store views shows "coming soon".
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
# The PEM private key from the service-account JSON, on one line with \n escapes.
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
