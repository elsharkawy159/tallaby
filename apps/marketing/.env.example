# apps/marketing (tallaby.com / www). Names only: values live in the host's env, never here.

# Database and Supabase (same project as the other apps)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
# Server-only: store-build intake uploads (private bucket)
SUPABASE_SERVICE_ROLE_KEY=

# Public origins
# tallaby.com's canonical origin (canonicals, hreflang, sitemap, signup redirects)
NEXT_PUBLIC_SITE_URL=
# Root domain for host parsing and the shared .tallaby.com session cookie
NEXT_PUBLIC_ROOT_DOMAIN=
# Public dashboard origin for the "start selling" CTA. Defaults to https://dashboard.tallaby.com/
NEXT_PUBLIC_DASHBOARD_URL=
# Tallaby support WhatsApp, international digits without "+". Unset hides the buttons.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Seller signup: signs the signup choice cookie between the dialog and
# /api/auth/signup-callback. Server-only, 32+ random chars.
SIGNUP_INTENT_SECRET=
# Affiliate program (F-37): domain of the ?ref= cookie, shared with the dashboard (.tallaby.com)
REFERRAL_COOKIE_DOMAIN=

# Hono backend (store-created email at signup)
BACKEND_API_URL=
INTERNAL_API_SECRET=

# Meta Pixel (public) + Conversions API for the signup event (server-only token)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# Prices in the visitor's currency
EXCHANGE_RATE_API_KEY=

# AI store builder intake on the home page
STORE_BUILDER_AI_ENABLED=
STORE_BUILD_IP_SALT=
FORM_IP_HASH_SALT=

# Cross-app cache invalidation (packages/cache): receive at /api/revalidate, send to peers.
# Same value in every app.
REVALIDATE_SECRET=
ECOMMERCE_URL=
DASHBOARD_URL=
ADMIN_URL=

# Self-hosting
# 1 when behind Cloudflare: trust cf-connecting-ip / cf-ipcountry
TRUST_CLOUDFLARE_HEADERS=
# Cache key per deploy (baked by the Docker image)
DEPLOY_ID=
