# Paymob (server-side — intention creation)
PAYMOB_SECRET_KEY=egy_sk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_PUBLIC_KEY=egy_pk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_CARD_INTEGRATION_ID=4604192
PAYMOB_WEBHOOK_URL=https://hooks.paymob.com/REPLACE_WITH_YOUR_HOOK_ID

# Paymob hosted checkout redirect return URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret for guest/cross-device order tracking links (?access=...)
ORDER_ACCESS_SECRET=replace-with-a-long-random-string

# Hono backend used to send transactional emails (order confirmation)
BACKEND_API_URL=http://localhost:4000
INTERNAL_API_SECRET=REPLACE_WITH_SHARED_SECRET

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cross-app cache invalidation (packages/cache — see docs/caching-and-data-fetching.md §7).
# Required for this app's own mutations to notify admin/dashboard, AND to
# receive their broadcasts at /api/revalidate — e.g. approving a product in
# admin needs this set here too, or the storefront only picks it up once its
# cache TTL expires (up to 15 min for listings) instead of immediately.
# Must be the exact same value in the admin and dashboard apps' env.
REVALIDATE_SECRET=REPLACE_WITH_SHARED_SECRET
ADMIN_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
