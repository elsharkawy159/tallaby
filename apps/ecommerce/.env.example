# Paymob (server-side — intention creation)
# Active online payment provider: kashier (default) | paymob
PAYMENT_PROVIDER=kashier

# Kashier (server-side only, never NEXT_PUBLIC_)
KASHIER_SECRET_KEY=REPLACE_WITH_YOUR_SECRET_KEY
KASHIER_PAYMENT_API_KEY=REPLACE_WITH_YOUR_PAYMENT_API_KEY
KASHIER_MERCHANT_ID=MID-REPLACE
KASHIER_MODE=test
# Public URL of the backend webhook
KASHIER_WEBHOOK_URL=https://api.tallaby.com/api/kashier/webhook
# KASHIER_ALLOWED_METHODS=card,wallet

PAYMOB_SECRET_KEY=egy_sk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_PUBLIC_KEY=egy_pk_test_REPLACE_WITH_YOUR_KEY
PAYMOB_CARD_INTEGRATION_ID=4604192
PAYMOB_WEBHOOK_URL=https://hooks.paymob.com/REPLACE_WITH_YOUR_HOOK_ID

# Paymob hosted checkout redirect return URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret for guest/cross-device order tracking links (?access=...)
ORDER_ACCESS_SECRET=replace-with-a-long-random-string

# Hono backend used to send transactional emails (order confirmation)
BACKEND_API_URL=http://localhost:4000
INTERNAL_API_SECRET=REPLACE_WITH_SHARED_SECRET

# PostHog browser analytics (production only — skipped when NODE_ENV=development)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Meta Pixel (public) + Conversions API (server-only — never expose the access token)
NEXT_PUBLIC_META_PIXEL_ID=3628548033960332
META_PIXEL_ID=3628548033960332
META_CONVERSIONS_API_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v21.0

# Cross-app cache invalidation (packages/cache — see docs/caching-and-data-fetching.md §7).
# Required for this app's own mutations to notify admin/dashboard, AND to
# receive their broadcasts at /api/revalidate — e.g. approving a product in
# admin needs this set here too, or the storefront only picks it up once its
# cache TTL expires (up to 15 min for listings) instead of immediately.
# Must be the exact same value in the admin and dashboard apps' env.
REVALIDATE_SECRET=REPLACE_WITH_SHARED_SECRET
ADMIN_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
# Public dashboard origin for the "start selling" CTA (→ /signup). Defaults to https://dashboard.tallaby.com/
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002/
# Signs the marketing signup choice cookie (store name/link) between the
# signup dialog and /api/auth/signup-callback. Server-only, 32+ random chars.
SIGNUP_INTENT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Seller custom domains (faster-eg.com). A Vercel token that can manage the
# ECOMMERCE project's domains; STOREFRONT_VERCEL_PROJECT_ID is that project in both apps.
STOREFRONT_VERCEL_TOKEN=
STOREFRONT_VERCEL_PROJECT_ID=
CRON_SECRET=
STOREFRONT_VERCEL_TEAM_ID=
# Vercel sends this as a Bearer token to /api/cron/* (set it in the project).

# Salt for hashing visitor IPs on store form submissions (P4-10); raw IPs are
# never stored. Falls back to INTERNAL_API_SECRET when empty.
FORM_IP_HASH_SALT=
# tallaby.com blog (lib/marketing/blog.server.ts): subdomain of the platform's own
# store whose dashboard blog feeds /blog. Unset: the built-in static posts.
# Tag a post lang:ar or lang:en to show it in one locale only, and with a
# category (guides, growth, stories, payments, product) to file it.
MARKETING_BLOG_STORE_SUBDOMAIN=
