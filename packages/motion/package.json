{
  "name": "@workspace/motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Native scroll animations (CSS presets + one IntersectionObserver) for the marketing site, and the animation settings schema store sites share",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./presets": {
      "types": "./src/presets.ts",
      "default": "./src/presets.ts"
    },
    "./init-script": {
      "types": "./src/init-script.ts",
      "default": "./src/init-script.ts"
    },
    "./animations.css": "./src/animations.css",
    "./motion.css": "./src/animations.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@workspace/typescript-config": "workspace:*",
    "react": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "jsdom": "28.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
