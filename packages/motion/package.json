{
  "name": "@workspace/motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scroll and intro motion presets (GSAP + ScrollTrigger + Lenis) for the marketing site and, later, store templates",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./presets": {
      "types": "./src/presets.ts",
      "default": "./src/presets.ts"
    },
    "./motion.css": "./src/motion.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@workspace/typescript-config": "workspace:*",
    "react": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
