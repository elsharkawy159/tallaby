exports[`motion v1 is frozen > team-story without the v2 marker renders as before (reveal on, public) > ar 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><div data-node-id="d1-n4" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n5" data-node-type="div" class="min-w-0"></div><p data-node-id="d1-n6" data-node-type="text" class="text-sm">قصتنا</p></div><h2 data-node-id="d1-n7" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">بدأنا من أوضة في الدقي بعشر سماعات وموبايل واحد.</h2></div><div data-node-id="d1-n8" data-node-type="grid" class="grid min-w-0"><img data-node-id="d1-n9" data-node-type="image" data-reveal="fade-up" src="https://cdn.test/https://images.pexels.com/photos/6214472/pexels-photo-6214472.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="صورة من المتجر" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n10" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">كنا بنبيع لأصحابنا على واتساب، وكل طلب كنا بنوصله بنفسنا. النهارده بقينا فريق من ١٢ شخص وبنوصل لكل محافظات مصر.</p><p data-node-id="d1-n12" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">لسه بنختار كل منتج بإيدينا، ولسه بنرد على كل رسالة.</p><p data-node-id="d1-n13" data-node-type="text" class="text-sm">— منى، المؤسسة</p></div></div></div></section></div>"`;

exports[`motion v1 is frozen > team-story without the v2 marker renders as before (reveal on, public) > en 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><div data-node-id="d1-n4" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n5" data-node-type="div" class="min-w-0"></div><p data-node-id="d1-n6" data-node-type="text" class="text-sm">Our story</p></div><h2 data-node-id="d1-n7" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">We started in a Dokki bedroom with ten earbuds and one phone.</h2></div><div data-node-id="d1-n8" data-node-type="grid" class="grid min-w-0"><img data-node-id="d1-n9" data-node-type="image" data-reveal="fade-up" src="https://cdn.test/https://images.pexels.com/photos/6214472/pexels-photo-6214472.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="A photo from the store" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n10" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">We sold to friends on WhatsApp and delivered every order ourselves. Today we are a team of 12 delivering to every governorate.</p><p data-node-id="d1-n12" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">We still pick every product by hand, and we still answer every message.</p><p data-node-id="d1-n13" data-node-type="text" class="text-sm">— Mona, founder</p></div></div></div></section></div>"`;

exports[`motion v1 is frozen > text-policy without the v2 marker renders as before (reveal on, public) > ar 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">المحتوى</p><p data-node-id="d1-n6" data-node-type="text" class="text-sm">الاسترجاع خلال ١٤ يومًا</p><p data-node-id="d1-n7" data-node-type="text" class="text-sm">كيف ترجع منتجًا</p><p data-node-id="d1-n8" data-node-type="text" class="text-sm">استرداد المبلغ</p><p data-node-id="d1-n9" data-node-type="text" class="text-sm">الاستبدال</p></div><div data-node-id="d1-n10" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="text" class="text-sm">آخر تحديث: ١ سبتمبر ٢٠٢٦</p><h3 data-node-id="d1-n12" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">الاسترجاع خلال ١٤ يومًا</h3><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">يمكنك إرجاع أي منتج غير مستخدم في علبته الأصلية خلال ١٤ يومًا من الاستلام.</p><h3 data-node-id="d1-n14" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">كيف ترجع منتجًا</h3><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">راسلنا على واتساب برقم الطلب وسنرتب استلامه من عنوانك.</p><h3 data-node-id="d1-n16" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">استرداد المبلغ</h3><p data-node-id="d1-n17" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">مدفوعات البطاقة والمحفظة تُرد خلال ٧ إلى ١٤ يومًا، وطلبات الدفع عند الاستلام تُرد على محفظة أو حساب بنكي.</p><h3 data-node-id="d1-n18" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">الاستبدال</h3><p data-node-id="d1-n19" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تريد مقاسًا أو لونًا آخر؟ نستبدله مجانًا مرة واحدة.</p></div></div></div></section></div>"`;

exports[`motion v1 is frozen > text-policy without the v2 marker renders as before (reveal on, public) > en 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">Contents</p><p data-node-id="d1-n6" data-node-type="text" class="text-sm">14-day returns</p><p data-node-id="d1-n7" data-node-type="text" class="text-sm">How to return</p><p data-node-id="d1-n8" data-node-type="text" class="text-sm">Refunds</p><p data-node-id="d1-n9" data-node-type="text" class="text-sm">Exchanges</p></div><div data-node-id="d1-n10" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="text" class="text-sm">Last updated: 1 Sep 2026</p><h3 data-node-id="d1-n12" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">14-day returns</h3><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Return any unused item in its original box within 14 days of delivery.</p><h3 data-node-id="d1-n14" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">How to return</h3><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Message us on WhatsApp with your order number and we arrange pickup from your address.</p><h3 data-node-id="d1-n16" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">Refunds</h3><p data-node-id="d1-n17" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Card and wallet payments are refunded within 7 to 14 days; cash orders by wallet or bank transfer.</p><h3 data-node-id="d1-n18" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">Exchanges</h3><p data-node-id="d1-n19" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Want another size or colour? We swap it for free once.</p></div></div></div></section></div>"`;

exports[`motion v1 is frozen > track-ask without the v2 marker renders as before (reveal on, public) > ar 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" class="flex min-w-0 flex-col"><div data-node-id="d1-n4" data-node-type="div" class="min-w-0 grid place-items-center"><span data-node-id="d1-n5" data-node-type="icon" class="inline-flex shrink-0 items-center justify-center align-middle leading-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck size-[1em]" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg></span></div><h2 data-node-id="d1-n6" data-node-type="heading" data-reveal="fade-up" class="text-balance text-2xl font-bold leading-tight md:text-3xl">فين طلبي؟</h2><p data-node-id="d1-n7" data-node-type="paragraph" data-reveal="fade-up" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">لو عامل حساب، حالة طلبك موجودة في صفحة طلباتي. لو طلبت من غير حساب، ابعتلنا رقم الطلب على واتساب.</p><div data-node-id="d1-n8" data-node-type="vFlex" class="flex min-w-0 flex-col"><a href="/profile/orders" class="block min-w-0"><span data-node-id="d1-n9" data-node-type="linkBlock" data-reveal="fade-up" class="block"><div data-node-id="d1-n10" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><span data-node-id="d1-n11" data-node-type="icon" class="in