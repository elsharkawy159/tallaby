399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg></span></div><div data-node-id="d1-n37" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n38" data-node-type="text" class="text-sm">Address</p><p data-node-id="d1-n39" data-node-type="text" class="text-sm">24 Tahrir St, Dokki</p></div></div></span></a><img data-node-id="d1-n40" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/34674788/pexels-photo-34674788.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="Store photo" class="block w-full" loading="lazy" decoding="async"/></div></div></div></section></div>"`;

exports[`motion v1 is frozen > faq-classic without the v2 marker renders as before (reveal on, public) > ar 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">الطلبات</p><p data-node-id="d1-n6" data-node-type="text" class="text-sm">التوصيل</p><p data-node-id="d1-n7" data-node-type="text" class="text-sm">الدفع والاسترجاع</p></div><div data-node-id="d1-n8" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><div data-node-id="d1-n9" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n10" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">الطلبات</h3><div data-node-id="d1-n11" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n12" data-node-type="accordionItem" open="" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">كيف أعرف أن طلبي وصل إليكم؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">ستظهر لك صفحة تأكيد وتصلك رسالة، ونتصل بك لتأكيد طلبات الدفع عند الاستلام.</p></div></details><details data-node-id="d1-n14" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">هل يمكنني تعديل طلبي أو إلغاؤه؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">نعم، حتى يتم شحنه. تواصل معنا بأسرع وقت.</p></div></details></div></div><div data-node-id="d1-n16" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n17" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">التوصيل</h3><div data-node-id="d1-n18" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n19" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">كم يستغرق التوصيل؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n20" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">القاهرة والجيزة من يوم إلى يومين، وباقي المحافظات من ٢ إلى ٦ أيام.</p></div></details><details data-node-id="d1-n21" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">هل التوصيل متاح لكل المحافظات؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n22" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">نعم، نوصل لكل محافظات مصر.</p></div></details></div></div><div data-node-id="d1-n23" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n24" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">الدفع والاسترجاع</h3><div data-node-id="d1-n25" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n26" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">ما طرق الدفع المتاحة؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n27" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">الدفع عند الاستلام، والبطاقات، والمحافظ الإلكترونية، وإنستاباي.</p></div></details><details data-node-id="d1-n28" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">ما سياسة الاسترجاع؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n29" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">يمكنك إرجاع أي منتج غير مستخدم خلال ١٤ يومًا في علبته الأصلية.</p></div></details></div></div><div data-node-id="d1-n30" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n31" data-node-type="vFlex" class="flex min-w-0 flex-col"><h4 data-node-id="d1-n32" data-node-type="heading" class="text-balance text-lg font-semibold leading-snug">ما زال لديك سؤال؟</h4><p data-node-id="d1-n33" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">راسلنا وسيرد عليك شخص حقيقي.</p></div><div data-node-id="d1-n34" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n36" data-node-type="button" class="flex"><a href="/contact" class="inline-flex h-12 items-center justify-center rounded-(--sf-radius,12px) px-7 text-sm font-semibold transition-[background-color,border-color,color,transform] duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0 border border-(--sf-line) bg-(--sf-paper) text-(--sf-ink) hover:border-(--sf-ink)">تواصل معنا</a></div></div></div></div></div></div></section></div>"`;

exports[`motion v1 is frozen > faq-classic without the v2 marker renders as before (reveal on, public) > en 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" data-reveal="fade-up" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">Orders</p><p data-node-id="d1-n6" data-node-type="text" class="text-sm">Delivery</p><p data-node-id="d1-n7" data-node-type="text" class="text-sm">Payment &amp; returns</p></div><div data-node-id="d1-n8" data-node-type="vFlex" data-reveal="fade-up" data-reveal-step="1" class="flex min-w-0 flex-col"><div data-node-id="d1-n9" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n10" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">Orders</h3><div data-node-id="d1-n11" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n12" data-node-type="accordionItem" open="" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">How do I know my order went through?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">You see a confirmation page and get a message; we also call to confirm cash orders.</p></div></details><details data-node-id="d1-n14" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">Can I change or cancel my order?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Yes, until it ships. Message us as soon as you can.</p></div></details></div></div><div data-node-id="d1-n16" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n17" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">Delivery</h3><div data-node-id="d1-n18" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n19" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">How long does delivery take?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n20" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Cairo and Giza in 1 to 2 days, other governorates in 2 to 6 days.</p></div></details><details data-node-id="d1-n21" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">Do you deliver everywhere?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n22" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Yes, we deliver to every governorate in Egypt.</p></div></details></div></div><div data-node-id="d1-n23" data-node-type="vFlex" class="flex min-w-0 flex-col"><h3 data-node-id="d1-n24" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">Payment &amp; returns</h3><div data-node-id="d1-n25" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n26" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">Which payment methods do you accept?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n27" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Cash on delivery, cards, mobile wallets and InstaPay.</p></div></details><details data-node-id="d1-n28" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">What is your return policy?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n29" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Return any unused item within 14 days in its original box.</p></div></details></div></div><div data-node-id="d1-n30" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n31" data-node-type="vFlex" class="flex min-w-0 flex-col"><h4 data-node-id="d1-n32" data-node-type="heading" class="text-balance text-lg font-semibold leading-snug">Still have a question?</h4><p data-node-id="d1-n33" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">Message us and a real person will reply.</p></div><div data-node-id="d1-n34" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n36" data-node-type="button" class="flex"><a href="/contact" class="inline-flex h-12 items-center justify-center rounded-(--sf-radius,12px) px-7 text-sm font-semibold transition-[background-color,border-color,color,transform] duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:tra