-id="d1-n16" data-node-type="grid" class="grid min-w-0"><img data-node-id="d1-n17" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/6567204/pexels-photo-6567204.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="نغلّف" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n18" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n19" data-node-type="text" class="text-sm">٠٣</p><h3 data-node-id="d1-n20" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">نغلّف</h3><p data-node-id="d1-n21" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تغليف محكم ومعه الفاتورة والضمان.</p></div></div></div></div></section></div>"`;

