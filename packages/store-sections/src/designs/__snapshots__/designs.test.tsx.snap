exports[`section designs > about-story matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="div" class="min-w-0"><div data-node-id="d1-n6" data-node-type="card" class="min-w-0"><h3 data-node-id="d1-n7" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">+٥٠٠٠</h3><p data-node-id="d1-n8" data-node-type="text" class="text-sm">عميل سعيد</p></div></div><div data-node-id="d1-n9" data-node-type="vFlex" class="flex min-w-0 flex-col"><div data-node-id="d1-n10" data-node-type="vFlex" class="flex min-w-0 flex-col"><span data-node-id="d1-n11" data-node-type="badge" class="inline-flex w-fit items-center rounded-full bg-(--sf-shelf) px-3 py-1 text-xs font-semibold">من نحن</span><h2 data-node-id="d1-n12" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">بدأنا بفكرة بسيطة: منتج جيد بسعر عادل</h2><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">اكتب هنا قصة متجرك: كيف بدأت، وما الذي يميز منتجاتك، ولماذا يعود إليك العملاء.</p><p data-node-id="d1-n14" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">العملاء يشترون من الناس الذين يعرفونهم ويثقون بهم.</p></div><div data-node-id="d1-n15" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n16" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><span data-node-id="d1-n17" data-node-type="icon" class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-[1em]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p data-node-id="d1-n18" data-node-type="text" class="text-sm">منتجات أصلية ١٠٠٪</p></div><div data-node-id="d1-n19" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><span data-node-id="d1-n20" data-node-type="icon" class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-[1em]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p data-node-id="d1-n21" data-node-type="text" class="text-sm">تغليف آمن لكل طلب</p></div><div data-node-id="d1-n22" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><span data-node-id="d1-n23" data-node-type="icon" class="inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-[1em]" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><p data-node-id="d1-n24" data-node-type="text" class="text-sm">دعم سريع عبر واتساب</p></div></div><div data-node-id="d1-n25" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n26" data-node-type="button" class="flex"><a href="/#products" class="inline-flex h-11 items-center justify-center rounded-(--sf-radius,12px) px-6 text-sm font-semibold transition-opacity hover:opacity-90 bg-(--sf-brand) text-(--sf-brand-ink,#fff)">تسوّق الآن</a></div></div></div></div></div></section></div>"`;

