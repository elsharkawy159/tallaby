exports[`section designs > text-columns matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><h2 data-node-id="d1-n4" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">عن متجرنا</h2><p data-node-id="d1-n5" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">بدأنا بهدف واحد: منتجات أصلية بسعر عادل، يختارها أشخاص يستخدمونها فعلًا.</p><p data-node-id="d1-n6" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">اليوم نشحن لكل المحافظات ونجرّب كل منتج قبل أن يصل إليك.</p></div></div></section></div>"`;

exports[`section designs > text-policy matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">المحتوى</p><p data-node-id="d1-n6" data-node-type="text" class="text-sm">الاسترجاع خلال ١٤ يومًا</p><p data-node-id="d1-n7" data-node-type="text" class="text-sm">كيف ترجع منتجًا</p><p data-node-id="d1-n8" data-node-type="text" class="text-sm">استرداد المبلغ</p><p data-node-id="d1-n9" data-node-type="text" class="text-sm">الاستبدال</p></div><div data-node-id="d1-n10" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="text" class="text-sm">آخر تحديث: ١ سبتمبر ٢٠٢٦</p><h2 data-node-id="d1-n12" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">الاسترجاع خلال ١٤ يومًا</h2><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">يمكنك إرجاع أي منتج غير مستخدم في علبته الأصلية خلال ١٤ يومًا من الاستلام.</p><h2 data-node-id="d1-n14" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">كيف ترجع منتجًا</h2><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">راسلنا على واتساب برقم الطلب وسنرتب استلامه من عنوانك.</p><h2 data-node-id="d1-n16" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">استرداد المبلغ</h2><p data-node-id="d1-n17" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">مدفوعات البطاقة والمحفظة تُرد خلال ٧ إلى ١٤ يومًا، وطلبات الدفع عند الاستلام تُرد على محفظة أو حساب بنكي.</p><h2 data-node-id="d1-n18" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">الاستبدال</h2><p data-node-id="d1-n19" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تريد مقاسًا أو لونًا آخر؟ نستبدله مجانًا مرة واحدة.</p></div></div></div></section></div>"`;

