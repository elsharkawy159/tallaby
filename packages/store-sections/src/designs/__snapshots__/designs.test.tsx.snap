exports[`section designs > about-classic matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><img data-node-id="d1-n4" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/34674788/pexels-photo-34674788.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="صورة المتجر" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n5" data-node-type="vFlex" class="flex min-w-0 flex-col"><span data-node-id="d1-n6" data-node-type="badge" class="inline-flex w-fit items-center rounded-full bg-(--sf-shelf) px-3 py-1 text-xs font-semibold">حكايتنا</span><h2 data-node-id="d1-n7" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">بدأنا بسؤال واحد: هل سيدوم؟</h2><p data-node-id="d1-n8" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">فتحنا متجرنا بعد أن تعبنا من منتجات لا تعيش. كل ما نبيعه نجربه نحن أولًا.</p><p data-node-id="d1-n9" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">اليوم نشحن لكل المحافظات ونرد على كل رسالة بأنفسنا.</p><div data-node-id="d1-n10" data-node-type="button" class="flex"><a href="/about" class="inline-flex h-11 items-center justify-center rounded-(--sf-radius,12px) px-6 text-sm font-semibold transition-opacity hover:opacity-90 bg-(--sf-brand) text-(--sf-brand-ink,#fff)">تعرّف علينا</a></div></div></div></div></section></div>"`;

exports[`section designs > about-overlap matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="div" class="min-w-0"><img data-node-id="d1-n4" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/8475169/pexels-photo-8475169.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="صورة المتجر" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n5" data-node-type="card" class="min-w-0"><div data-node-id="d1-n6" data-node-type="vFlex" class="flex min-w-0 flex-col"><span data-node-id="d1-n7" data-node-type="badge" class="inline-flex w-fit items-center rounded-full bg-(--sf-shelf) px-3 py-1 text-xs font-semibold">من داخل المتجر</span><h2 data-node-id="d1-n8" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">بدأنا من محل صغير</h2><p data-node-id="d1-n9" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">نختار كل منتج بعناية ونغلّفه بأيدينا، ونعرف عملاءنا بالاسم.</p><div data-node-id="d1-n10" data-node-type="button" class="flex"><a href="/about" class="inline-flex h-11 items-center justify-center rounded-(--sf-radius,12px) px-6 text-sm font-semibold transition-opacity hover:opacity-90 bg-(--sf-brand) text-(--sf-brand-ink,#fff)">اعرف أكثر</a></div></div></div></div></div></section></div>"`;

exports[`section designs > about-panel matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><h2 data-node-id="d1-n4" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">لماذا بدأنا</h2><div data-node-id="d1-n5" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n6" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">كنا نجرب كل منتج بأنفسنا قبل أن نبيعه، وما زلنا نفعل ذلك مع كل ما يدخل المتجر.</p><p data-node-id="d1-n7" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">اليوم يعود إلينا آلاف العملاء، وهذا أكبر دليل على أن الطريقة صحيحة.</p><blockquote data-node-id="d1-n8" data-node-type="blockQuote" class="border-s-4 border-(--sf-brand) ps-4 text-lg italic leading-relaxed">«إن لم نستخدمه نحن، لن نبيعه.»</blockquote></div></div></div></section></div>"`;

