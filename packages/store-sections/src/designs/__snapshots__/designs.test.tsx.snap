exports[`section designs > stats-cards matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="pattern" aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 [background-image:linear-gradient(var(--sf-line)_1px,transparent_1px),linear-gradient(90deg,var(--sf-line)_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_80%)]"></div><div data-node-id="d1-n3" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1200px) px-4 md:px-8"><div data-node-id="d1-n4" data-node-type="vFlex" class="flex min-w-0 flex-col"><span data-node-id="d1-n5" data-node-type="badge" class="inline-flex w-fit items-center rounded-full bg-(--sf-shelf) px-3 py-1 text-xs font-semibold">بالأرقام</span><h2 data-node-id="d1-n6" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">ثقة بنيناها طلبًا بعد طلب</h2><p data-node-id="d1-n7" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">بدأنا متجرًا صغيرًا، واليوم يثق بنا آلاف العملاء في كل محافظات مصر.</p></div><div data-node-id="d1-n8" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n9" data-node-type="card" class="min-w-0"><h3 data-node-id="d1-n10" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">٢٠٢٠</h3><p data-node-id="d1-n11" data-node-type="text" class="text-sm">سنة البداية</p><p data-node-id="d1-n12" data-node-type="text" class="text-sm">من القاهرة</p></div><div data-node-id="d1-n13" data-node-type="card" class="min-w-0"><h3 data-node-id="d1-n14" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">+١٢ ألف</h3><p data-node-id="d1-n15" data-node-type="text" class="text-sm">طلب تم توصيله</p><p data-node-id="d1-n16" data-node-type="text" class="text-sm">لكل المحافظات</p></div><div data-node-id="d1-n17" data-node-type="card" class="min-w-0"><h3 data-node-id="d1-n18" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">٤٫٩</h3><p data-node-id="d1-n19" data-node-type="text" class="text-sm">متوسط التقييم</p><p data-node-id="d1-n20" data-node-type="text" class="text-sm">من آراء العملاء</p></div><div data-node-id="d1-n21" data-node-type="card" class="min-w-0"><h3 data-node-id="d1-n22" data-node-type="heading" class="text-balance text-xl font-semibold leading-snug">٢٤ ساعة</h3><p data-node-id="d1-n23" data-node-type="text" class="text-sm">للرد على الرسائل</p><p data-node-id="d1-n24" data-node-type="text" class="text-sm">طوال الأسبوع</p></div></div></div></section></div>"`;
