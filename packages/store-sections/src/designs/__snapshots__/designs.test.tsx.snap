exports[`section designs > product-shipping matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" data-sf-mv="2" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" class="flex min-w-0 flex-col"><h2 data-node-id="d1-n4" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">قبل أن تطلب</h2><div data-node-id="d1-n5" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n6" data-node-type="accordionItem" open="" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">الشحن والتوصيل<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n7" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">٤٨ ساعة للقاهرة والجيزة، ومن ٢ إلى ٤ أيام لباقي المحافظات. نؤكد الطلب بمكالمة أو رسالة قبل الشحن.</p></div></details><details data-node-id="d1-n8" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">الاسترجاع والاستبدال<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n9" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">يمكنك إرجاع أي منتج غير مستخدم في علبته الأصلية خلال ١٤ يومًا من الاستلام، ونستبدل المقاس أو اللون مرة واحدة مجانًا.</p></div></details><details data-node-id="d1-n10" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">طرق الدفع<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n11" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">الدفع عند الاستلام، أو بالبطاقة والمحفظة الإلكترونية عند الطلب.</p></div></details></div></div></div></section></div>"`;

