exports[`section designs > faq-side matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" data-sf-mv="2" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="grid" class="grid min-w-0"><div data-node-id="d1-n4" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n5" data-node-type="text" class="text-sm">الأسئلة الشائعة</p><h2 data-node-id="d1-n6" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">لديك سؤال؟</h2><p data-node-id="d1-n7" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">جمعنا لك أكثر الأسئلة تكرارًا عن الطلب والشحن. وإن لم تجد سؤالك هنا، تواصل معنا.</p><div data-node-id="d1-n8" data-node-type="button" class="flex"><a href="/faq" class="inline-flex h-12 items-center justify-center rounded-(--sf-radius,12px) px-7 text-sm font-semibold transition-[background-color,border-color,color,transform] duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0 bg-(--sf-brand) text-(--sf-brand-ink,#fff) hover:bg-[color-mix(in_srgb,var(--sf-brand)_86%,#000)]">كل الأسئلة</a></div></div><div data-node-id="d1-n9" data-node-type="div" class="min-w-0"><img data-node-id="d1-n10" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/6919423/pexels-photo-6919423.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="صورة القسم" class="block w-full" loading="lazy" decoding="async"/></div><div data-node-id="d1-n11" data-node-type="accordion" class="flex flex-col"><details data-node-id="d1-n12" data-node-type="accordionItem" open="" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">كيف أعرف أن طلبي وصل إليكم؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n13" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">ستظهر لك صفحة تأكيد بعد إتمام الطلب.</p></div></details><details data-node-id="d1-n14" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">هل يمكنني تعديل طلبي أو إلغاؤه؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n15" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تواصل معنا في أقرب وقت لنراجع طلبك.</p></div></details><details data-node-id="d1-n16" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">كم يستغرق التوصيل؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n17" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تظهر تكلفة الشحن ومدته عند إتمام الطلب.</p></div></details><details data-node-id="d1-n18" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">إلى أين يتوفر التوصيل؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n19" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تظهر مناطق التوصيل المتاحة عند إتمام الطلب.</p></div></details><details data-node-id="d1-n20" data-node-type="accordionItem" class="group border-b border-(--sf-line) py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-start font-semibold [&amp;::-webkit-details-marker]:hidden">ما طرق الدفع المتاحة؟<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-4 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="mt-3"><p data-node-id="d1-n21" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">تظهر طرق الدفع المتاحة عند إتمام الطلب.</p></div></details></div></div></div></section></div>"`;

