exports[`section designs > track-ask matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" data-sf-mv="2" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" class="flex min-w-0 flex-col"><div data-node-id="d1-n4" data-node-type="div" class="min-w-0 grid place-items-center"><span data-node-id="d1-n5" data-node-type="icon" class="inline-flex shrink-0 items-center justify-center align-middle leading-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck size-[1em]" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg></span></div><h2 data-node-id="d1-n6" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">أين طلبي؟</h2><p data-node-id="d1-n7" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">إذا كان لديك حساب، ستجد حالة طلبك في صفحة طلباتي. وإذا طلبت بدون حساب، أرسل لنا رقم الطلب على واتساب.</p><div data-node-id="d1-n8" data-node-type="vFlex" class="flex min-w-0 flex-col"><a href="/profile/orders" class="block min-w-0"><span data-node-id="d1-n9" data-node-type="linkBlock" data-sf-link="" class="block"><div data-node-id="d1-n10" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><span data-node-id="d1-n11" data-node-type="icon" class="inline-flex shrink-0 items-center justify-center align-middle leadin