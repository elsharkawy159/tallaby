exports[`section designs > team-story matches its snapshot (ar, public) 1`] = `"<div data-section-id="d1" data-section-type="custom-section"><section data-node-id="d1-n1" data-node-type="section" data-sf-mv="2" class="relative isolate overflow-x-clip"><div data-node-id="d1-n2" data-node-type="container" class="mx-auto w-full max-w-(--sf-max-width,1280px) px-[clamp(16px,4vw,48px)]"><div data-node-id="d1-n3" data-node-type="vFlex" class="flex min-w-0 flex-col"><div data-node-id="d1-n4" data-node-type="hFlex" class="flex min-w-0 flex-row flex-wrap"><div data-node-id="d1-n5" data-node-type="div" class="min-w-0"></div><p data-node-id="d1-n6" data-node-type="text" class="text-sm">قصتنا</p></div><h2 data-node-id="d1-n7" data-node-type="heading" class="text-balance text-2xl font-bold leading-tight md:text-3xl">بدأنا بفكرة بسيطة: منتجات جيدة بأسعار واضحة.</h2></div><div data-node-id="d1-n8" data-node-type="grid" class="grid min-w-0"><img data-node-id="d1-n9" data-node-type="image" src="https://cdn.test/https://images.pexels.com/photos/6214472/pexels-photo-6214472.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="صورة من المتجر" class="block w-full" loading="lazy" decoding="async"/><div data-node-id="d1-n10" data-node-type="vFlex" class="flex min-w-0 flex-col"><p data-node-id="d1-n11" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">بدأنا صغارًا، نختار كل منتج بعناية. واليوم نقدّم تشكيلة أوسع بالطريقة نفسها.</p><p data-node-id="d1-n12" data-node-type="paragraph" class="whitespace-pre-line text-pretty leading-relaxed text-(--sf-muted)">ما زلنا نختار كل منتج بعناية، ونهتم بكل تفاصيله.</p><p data-node-id="d1-n13" data-node-type="text" class="text-sm">— منى، المؤسسة</p></div></div></div></section></div>"`;

