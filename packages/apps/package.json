{
  "name": "@workspace/apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Tallaby App Center registry: one manifest per app or integration, shared by the dashboard, the public catalog API and (later) apps.tallaby.com. Pure data, no secrets, no store data.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./public": {
      "types": "./src/public.ts",
      "default": "./src/public.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
