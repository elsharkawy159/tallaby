{
  "name": "@workspace/store-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The website builder (editor) shared by the seller dashboard and the admin app; hosts plug in through an EditorAdapter",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./messages/ar.json": "./src/messages/ar.json",
    "./messages/en.json": "./src/messages/en.json",
    "./lib/*": "./src/lib/*.ts",
    "./state/*": "./src/state/*.ts",
    "./dnd/*": "./src/dnd/*.ts",
    "./canvas/*": "./src/canvas/*.ts",
    "./templates.dto": "./src/templates.dto.ts",
    "./editor.dto": "./src/editor.dto.ts",
    "./editor.client": "./src/editor.client.tsx",
    "./media/media-library.client": "./src/media/media-library.client.tsx",
    "./media/media-picker.client": "./src/media/media-picker.client.tsx",
    "./media/*": "./src/media/*.ts",
    "./preview/site-preview.client": "./src/preview/site-preview.client.tsx",
    "./preview/template-live-thumbnail.client": "./src/preview/template-live-thumbnail.client.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@workspace/lib": "workspace:*",
    "@workspace/store-sections": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.562.0",
    "react-dropzone": "^14.3.8",
    "sonner": "^2.0.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@workspace/typescript-config": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "next": "^16.3.3",
    "next-intl": "^4.14.2",
    "react": "^19.0.0"
  }
}
