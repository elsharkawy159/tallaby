{
  "name": "@workspace/cache",
  "version": "1.0.0",
  "description": "Centralized cache-tag, cache-key and invalidation utilities shared by admin, dashboard and ecommerce",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./tags": {
      "types": "./src/tags.ts",
      "import": "./src/tags.ts",
      "require": "./src/tags.ts"
    },
    "./invalidate": {
      "types": "./src/invalidate.ts",
      "import": "./src/invalidate.ts",
      "require": "./src/invalidate.ts"
    },
    "./key": {
      "types": "./src/key.ts",
      "import": "./src/key.ts",
      "require": "./src/key.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@workspace/typescript-config": "workspace:*",
    "next": "16.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
